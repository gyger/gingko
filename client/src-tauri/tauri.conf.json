{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gingko Writer",
  "version": "3.0.0",
  "identifier": "com.gingkowriter.desktop",
  "build": {
    "frontendDist": "../tauri-web",
    "beforeDevCommand": "bun run tauri:frontend",
    "beforeBuildCommand": "bun run tauri:frontend -- --production"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../build/icon.ico", "../build/icon.icns"],
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["gkw"],
        "name": "Gingko Writer Document",
        "description": "Gingko Writer Document",
        "mimeType": "application/vnd.gingko-writer.tree-document"
      },
      {
        "ext": ["gko"],
        "name": "Gingko Document",
        "description": "Gingko Desktop Legacy Document",
        "mimeType": "application/vnd.gingko.tree-document"
      }
    ]
  }
}
