{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the home and document windows",
  "windows": ["home", "doc-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:webview:allow-internal-toggle-devtools",
    "dialog:default",
    "opener:default",
    "opener:allow-open-url",
    "allow-get-home-state",
    "allow-new-document",
    "allow-open-document",
    "allow-open-document-dialog",
    "allow-import-document",
    "allow-remove-recent-document",
    "allow-import-json-dialog",
    "allow-get-doc-state",
    "allow-save-file",
    "allow-save-as",
    "allow-commit-data",
    "allow-local-store-set",
    "allow-set-edit-mode",
    "allow-export-file",
    "allow-export-docx",
    "allow-ask-save-changes",
    "allow-save-file-dialog",
    "allow-export-file-dialog",
    "allow-close-document"
  ]
}
